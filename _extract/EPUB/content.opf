<package xmlns="http://www.idpf.org/2007/opf" unique-identifier="BookId" version="3.0" prefix="rendition: http://www.idpf.org/vocab/rendition/#">
  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:opf="http://www.idpf.org/2007/opf">
    <meta property="dcterms:modified">2026-04-28T16:08:00Z</meta>
    <dc:title>格律诗写作自学教程</dc:title>
    <dc:creator>杨祥雨</dc:creator>
    <dc:language>zh-CN</dc:language>
    <dc:publisher>岳麓书社</dc:publisher>
    <dc:description>本书围绕格律诗写作这一主题，对格律诗写作的基本常识、基本能力、表达方法、创新方法、写作修改与个人修养、句法现象等方面做了全面系统的阐述讨论，写作方式上注重从实际出发，注重格律诗写作实际运用的能力，有助于爱好者对格律诗的理解和实际操作。全书共分六篇73讲。</dc:description>
    <dc:date>2016-05-01</dc:date>
